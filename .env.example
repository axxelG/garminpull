# OPTIONAL. garminpull works without this file — if it's absent (or the values are
# empty), you'll simply be prompted for your Garmin email and password on the first run.
#
# Credentials are only needed for the initial login (or after the cached tokens under
# ~/.garminconnect expire). To avoid the prompt, copy this file to .env and fill it in:
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your-password

# Optional: override where OAuth tokens are cached.
# GARMINTOKENS=~/.garminconnect
